# ─────────────────────────────────────────────────────────────
# Pinceles — variables de entorno
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env / .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública del proyecto Supabase (self-hosted o cloud)
NEXT_PUBLIC_SUPABASE_URL=https://api.neura.com.py

# Clave anónima (pública por diseño — segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SOLO servidor. NUNCA con prefijo NEXT_PUBLIC.
# Saltea RLS: tratala como secreto máximo.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a Postgres (para migraciones/seed y scripts)
# Formato: postgresql://usuario:password@host:puerto/db?sslmode=require
DATABASE_URL=

# URL pública del sitio (para SEO, sitemap, canónicas, reset de contraseña)
NEXT_PUBLIC_SITE_URL=https://pinceles.com.py

# Credenciales del primer administrador (solo las lee scripts/create-admin.ts)
# No se guardan en la base ni se imprimen.
ADMIN_EMAIL=
ADMIN_PASSWORD=
